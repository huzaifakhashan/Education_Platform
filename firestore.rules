rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function profilePath(uid) { return /databases/$(database)/documents/profiles/$(uid); }
    function myRole() {
      return exists(profilePath(request.auth.uid))
        ? get(profilePath(request.auth.uid)).data.role
        : 'none';
    }
    function isAdmin() { return signedIn() && myRole() == 'admin'; }
    function isTeacher() { return signedIn() && myRole() == 'teacher'; }
    function isStaff() { return isAdmin() || isTeacher(); }

    // ---- Profiles: name + role, readable by any signed-in user.
    match /profiles/{uid} {
      allow read: if signedIn();
      // Anyone may create their own profile as a student. The single admin
      // profile can only be created together with the one-time meta/admin claim.
      allow create: if signedIn() && request.auth.uid == uid && (
        request.resource.data.role == 'student' ||
        (request.resource.data.role == 'admin' &&
         !exists(/databases/$(database)/documents/meta/admin) &&
         getAfter(/databases/$(database)/documents/meta/admin).data.uid == uid)
      );
      // Users may edit their own profile but never their role; only admins change roles.
      allow update: if isAdmin() ||
        (signedIn() && request.auth.uid == uid &&
         request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    // One-time "first admin" claim marker. Never editable afterwards.
    match /meta/admin {
      allow read: if signedIn();
      allow create: if signedIn() &&
        !exists(/databases/$(database)/documents/meta/admin) &&
        request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // ---- Courses: everyone signed-in can read; staff manage.
    match /courses/{courseId} {
      allow read: if signedIn();
      allow create: if isStaff() && request.resource.data.instructorId == request.auth.uid;
      allow update: if isAdmin() ||
        (isTeacher() &&
         resource.data.instructorId == request.auth.uid &&
         request.resource.data.instructorId == request.auth.uid);
      allow delete: if isAdmin() ||
        (isTeacher() && resource.data.instructorId == request.auth.uid);
    }

    // ---- Per-user progress.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // ---- Private one-to-one chats (id = sorted "uidA_uidB").
    match /chats/{chatId} {
      allow read: if signedIn() &&
        (resource == null || request.auth.uid in resource.data.participants);
      allow create: if signedIn() &&
        request.auth.uid in request.resource.data.participants &&
        request.resource.data.participants.size() == 2 &&
        chatId == request.resource.data.participants.join('_');
      allow update: if signedIn() &&
        request.auth.uid in resource.data.participants &&
        request.resource.data.participants == resource.data.participants;

      match /messages/{messageId} {
        allow read: if signedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if signedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 2000;
      }
    }
  }
}
